# Your Anthropic key lives ONLY here, on the server. Never inside the APK.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: a code the app must send, so strangers can't spend your credits
ACCESS_CODE=
# SMTP used to email applications on the graduate's behalf (e.g. Brevo, Gmail app password, Resend SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Applications are sent FROM this address; replies go to the graduate's own email
MAIL_FROM="NaijaGrad Jobs <apply@yourdomain.com>"
PORT=8787
